[Unit]
Description=OPC Platform Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opcplatform
Group=opcplatform
WorkingDirectory=/opt/opc-platform/collector
EnvironmentFile=/etc/opc-platform/opc-platform.env
ExecStart=/opt/opc-platform/.venv/bin/python -m collector.main
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/opc-platform /var/lib/opc-platform

# Ensure the directory that contains COLLECTOR_SQLITE_PATH exists and is writable
# by the service account before first start. Example:
#   install -o opcplatform -g opcplatform -d /var/lib/opc-platform

[Install]
WantedBy=multi-user.target
