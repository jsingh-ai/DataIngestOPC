[Unit]
Description=OPC Platform API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opcplatform
Group=opcplatform
WorkingDirectory=/opt/opc-platform/api
EnvironmentFile=/etc/opc-platform/opc-platform.env
ExecStart=/opt/opc-platform/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/opc-platform

[Install]
WantedBy=multi-user.target
